{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "format": {
      "type": "string",
      "const": "ABL-PUBLICATION-MANIFEST-V1"
    },
    "stage": {
      "type": "string",
      "enum": [
        "READ_ONLY_BEACON",
        "FOUNDING_SEASON",
        "GENESIS"
      ]
    },
    "ablReleaseCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "launchStateDigest": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{64}$"
    },
    "origins": {
      "type": "object",
      "properties": {
        "publicApi": {
          "type": "string",
          "format": "uri"
        },
        "arena": {
          "type": "string",
          "format": "uri"
        },
        "candidateIntake": {
          "anyOf": [
            {
              "type": "string",
              "format": "uri"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "publicApi",
        "arena",
        "candidateIntake"
      ],
      "additionalProperties": false
    },
    "files": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "mediaType": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^0x[0-9a-f]{64}$"
          }
        },
        "required": [
          "path",
          "bytes",
          "mediaType",
          "sha256"
        ],
        "additionalProperties": false
      }
    },
    "publicImages": {
      "minItems": 2,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "enum": [
              "public-api",
              "arena",
              "candidate-edge",
              "career",
              "broker"
            ]
          },
          "provider": {
            "type": "string",
            "const": "BLAXEL"
          },
          "imageReference": {
            "type": "string",
            "pattern": "^sandbox\\/[a-z0-9-]+:b[0-9a-f]{20}$"
          },
          "buildContextSha256": {
            "type": "string",
            "pattern": "^0x[0-9a-f]{64}$"
          }
        },
        "required": [
          "name",
          "provider",
          "imageReference",
          "buildContextSha256"
        ],
        "additionalProperties": false
      }
    },
    "privateDeploymentDigest": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{64}$"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "compatibilityVersion": {
      "type": "string",
      "const": "3.0.0"
    }
  },
  "required": [
    "format",
    "stage",
    "ablReleaseCommit",
    "launchStateDigest",
    "origins",
    "files",
    "publicImages",
    "privateDeploymentDigest",
    "createdAt",
    "compatibilityVersion"
  ],
  "additionalProperties": false
}
