{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "format": {
      "type": "string",
      "const": "ABL-PUBLIC-EVENT-PACKET-V1"
    },
    "trust": {
      "type": "object",
      "properties": {
        "domain": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "chainId": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "verifyingContract": {
              "type": "string",
              "pattern": "^0x[0-9a-fA-F]{40}$"
            }
          },
          "required": [
            "name",
            "version"
          ],
          "additionalProperties": false
        },
        "registry": {
          "minItems": 1,
          "maxItems": 128,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "address": {
                "type": "string",
                "pattern": "^0x[0-9a-fA-F]{40}$"
              },
              "did": {
                "type": "string",
                "pattern": "^did:.*"
              },
              "role": {
                "type": "string",
                "enum": [
                  "CAREER_AGENT",
                  "COMMISSIONER",
                  "INTEGRITY_OFFICER",
                  "TRIBUNAL",
                  "PREMIER_PLAYER_BOARD",
                  "DEVELOPMENT_PLAYER_BOARD",
                  "PREMIER_GOVERNOR",
                  "DEVELOPMENT_GOVERNOR",
                  "REFEREE",
                  "REPLAY_OFFICIAL",
                  "PROJECTOR"
                ]
              },
              "validFrom": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
              },
              "validUntil": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "date-time",
                    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "revokedAt": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "date-time",
                    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "purpose": {
                "type": "string",
                "const": "SIGNING"
              }
            },
            "required": [
              "address",
              "did",
              "role",
              "validFrom",
              "validUntil",
              "revokedAt",
              "purpose"
            ],
            "additionalProperties": false
          }
        },
        "threshold": {
          "type": "object",
          "properties": {
            "policyId": {
              "type": "string",
              "minLength": 1
            },
            "groups": {
              "minItems": 1,
              "maxItems": 12,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "role": {
                    "type": "string",
                    "enum": [
                      "CAREER_AGENT",
                      "COMMISSIONER",
                      "INTEGRITY_OFFICER",
                      "TRIBUNAL",
                      "PREMIER_PLAYER_BOARD",
                      "DEVELOPMENT_PLAYER_BOARD",
                      "PREMIER_GOVERNOR",
                      "DEVELOPMENT_GOVERNOR",
                      "REFEREE",
                      "REPLAY_OFFICIAL",
                      "PROJECTOR"
                    ]
                  },
                  "required": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "role",
                  "required"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "policyId",
            "groups"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "domain",
        "registry",
        "threshold"
      ],
      "additionalProperties": false
    },
    "evaluatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "events": {
      "minItems": 1,
      "maxItems": 100000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "event": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "signatures": {
            "minItems": 1,
            "maxItems": 128,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^0x[0-9a-fA-F]{130}$"
            }
          }
        },
        "required": [
          "event",
          "signatures"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "format",
    "trust",
    "evaluatedAt",
    "events"
  ],
  "additionalProperties": false
}
